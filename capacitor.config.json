{
  "appId": "com.studiolinicro.linicro",
  "appName": "Linicro",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#101418",
    "scrollEnabled": false,
    "allowsLinkPreview": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#101418",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
